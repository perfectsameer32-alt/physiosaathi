# Pysiosaathi Environment Configuration — Example Template

# Production Real Mode vs Demo Mode
# Set to 'false' to disable demo mode badges/banners and use real authentication for patients and doctors.
VITE_DEMO_MODE=false

# Optional Supabase Authentication & PostgreSQL Database
# When left blank, Pysiosaathi uses secure persistent local authentication and storage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional AI Assistant API Key (Google Gemini API)
# Get your API key from Google AI Studio: https://aistudio.google.com/
VITE_AI_ENABLED=true
VITE_GEMINI_API_KEY=your-gemini-api-key
